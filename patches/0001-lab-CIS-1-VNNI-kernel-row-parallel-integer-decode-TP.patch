diff --git a/aegis-linux/examples/cis_decode_timed.rs b/aegis-linux/examples/cis_decode_timed.rs
new file mode 100644
index 0000000..b04766c
--- /dev/null
+++ b/aegis-linux/examples/cis_decode_timed.rs
@@ -0,0 +1,122 @@
+//! cis_decode_timed — the SAME deterministic CIS-1 FullInt greedy decode as
+//! `cis_decode` (same digest line, same inputs), plus wall-clock timing of the
+//! decode loop only (model load and engine construction excluded).
+//!
+//! Rule A applies in full: this binary names the CPU from CPUID and prints
+//! `env=vm` when the hypervisor bit is set; a figure taken in a VM, in CI, or
+//! under emulation is NOT a performance claim and must not be quoted as one.
+//! What this binary is for: same-machine, same-binary RATIOS — threads 1 vs N
+//! (`AEGIS_THREADS`), kernel toggles — with the digest printed alongside so a
+//! speed-up that changes a single bit is caught in the same run.
+//!
+//! Run: cis_decode_timed <MODEL.SAF> <EMBED.BIN> <VOCAB.BIN> [max_new] [prompt] [repeats]
+//! Build: cargo build --release --features parallel --example cis_decode_timed
+use aegis_core::cis_infer::{CisEngine, CisMode, CisModel, argmax_i64, fnv1a64};
+use aegis_core::model::{FullBitNetPipeline, ModelConfig, SafeTensors};
+use aegis_core::tokenizer::AegisTokenizer;
+use std::time::Instant;
+
+fn cpu_brand() -> String {
+    let mut s = String::new();
+    for leaf in 0x8000_0002u32..=0x8000_0004 {
+        let r = unsafe { core::arch::x86_64::__cpuid(leaf) };
+        for v in [r.eax, r.ebx, r.ecx, r.edx] {
+            s.push_str(&String::from_utf8_lossy(&v.to_le_bytes()));
+        }
+    }
+    s.trim_matches(char::from(0)).trim().to_string()
+}
+fn hypervisor() -> bool {
+    (unsafe { core::arch::x86_64::__cpuid(1) }.ecx >> 31) & 1 == 1
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    if args.len() < 4 {
+        eprintln!(
+            "usage: cis_decode_timed <MODEL.SAF> <EMBED.BIN> <VOCAB.BIN> [max_new] [prompt] [repeats]"
+        );
+        std::process::exit(2);
+    }
+    let max_new: usize = args.get(4).and_then(|s| s.parse().ok()).unwrap_or(64);
+    let prompt = args
+        .get(5)
+        .map(String::as_str)
+        .unwrap_or("Once upon a time");
+    let repeats: usize = args.get(6).and_then(|s| s.parse().ok()).unwrap_or(3);
+    let model_bytes = std::fs::read(&args[1]).expect("read MODEL.SAF");
+    let embed_bytes = std::fs::read(&args[2]).expect("read EMBED.BIN");
+    let vocab_bytes = std::fs::read(&args[3]).expect("read VOCAB.BIN");
+    let tensors = SafeTensors::deserialize(&model_bytes).expect("parse MODEL.SAF");
+    let cfg_json = tensors
+        .metadata_field("aegis_config")
+        .expect("read __metadata__")
+        .expect("MODEL.SAF carries no aegis_config");
+    let config = ModelConfig::from_json(&cfg_json).expect("parse aegis_config");
+    let pipeline = FullBitNetPipeline::new(&tensors, &embed_bytes, &config).expect("pipeline");
+    let cis_model = CisModel::new(&pipeline, &config).expect("CIS model");
+    let tokenizer = AegisTokenizer::new(&vocab_bytes).expect("VOCAB.BIN");
+    let prompt_ids = tokenizer.encode(prompt);
+    // Thread count the pool will use; 1 without the `parallel` feature.
+    #[cfg(feature = "parallel")]
+    let threads = aegis_core::ops::worker_threads();
+    #[cfg(not(feature = "parallel"))]
+    let threads = 1usize;
+    println!(
+        "CIS_DECODE_TIMED cpu=\"{}\" env={} threads={} vnni=\"{}\" layers={} hidden={} vocab={} prompt_toks={} max_new={} repeats={}",
+        cpu_brand(),
+        if hypervisor() { "vm" } else { "iron" },
+        threads,
+        aegis_core::cis_vnni::vnni_level_name(),
+        config.num_hidden_layers,
+        config.hidden_size,
+        config.vocab_size,
+        prompt_ids.len(),
+        max_new,
+        repeats
+    );
+    let mut digests = Vec::new();
+    let mut decode_secs = Vec::new();
+    let mut prefill_secs = Vec::new();
+    for rep in 0..repeats {
+        let mut engine = CisEngine::new_with_mode(&cis_model, CisMode::FullInt);
+        let mut fnv: u64 = 0xcbf2_9ce4_8422_2325;
+        let t0 = Instant::now();
+        let mut pos = 0usize;
+        for &t in &prompt_ids {
+            fnv = fnv1a64(fnv, &t.to_le_bytes());
+            engine.forward_step_int(t, pos);
+            pos += 1;
+        }
+        let t1 = Instant::now();
+        for _ in 0..max_new {
+            let tok = argmax_i64(engine.decode_logits());
+            fnv = fnv1a64(fnv, &tok.to_le_bytes());
+            engine.forward_step_int(tok, pos);
+            pos += 1;
+        }
+        let t2 = Instant::now();
+        let dsec = (t2 - t1).as_secs_f64();
+        println!(
+            "rep={rep} prefill_s={:.3} decode_s={:.3} tok_per_s={:.3} digest={fnv:016x}",
+            (t1 - t0).as_secs_f64(),
+            dsec,
+            max_new as f64 / dsec
+        );
+        digests.push(fnv);
+        decode_secs.push(dsec);
+        prefill_secs.push((t1 - t0).as_secs_f64());
+    }
+    decode_secs.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    let med = decode_secs[decode_secs.len() / 2];
+    let all_same = digests.iter().all(|&d| d == digests[0]);
+    println!(
+        "CIS_DECODE_TIMED_SUMMARY threads={} median_decode_s={:.3} median_tok_per_s={:.3} digest={:016x} digests_identical_across_repeats={} (env={}; ratios only)",
+        threads,
+        med,
+        max_new as f64 / med,
+        digests[0],
+        all_same,
+        if hypervisor() { "vm" } else { "iron" }
+    );
+}
