+        assert_eq!(flush_context(&b[..n]), Err(Error::TpmRc(0x101)));
+        // TPM_RC_INITIALIZE on a second Startup
+        let (b, n) = rsp(TPM_ST_NO_SESSIONS, TPM_RC_INITIALIZE, &[]);
+        assert_eq!(startup(&b[..n]), Err(Error::TpmRc(0x100)));
+    }
