diff --git a/aegis-uefi/src/attest.rs b/aegis-uefi/src/attest.rs
new file mode 100644
index 0000000..8a5b4b9
--- /dev/null
+++ b/aegis-uefi/src/attest.rs
@@ -0,0 +1,449 @@
+//! AEGIS-ATTEST v0 — measured-boot attestation of the inference payload.
+//!
+//! Closes the attribution hole recorded in ledger A33/A34 ("the unikernel's
+//! verifier prints no CPU identifier") with a hardware root of trust instead
+//! of a log line: when the firmware exposes `EFI_TCG2_PROTOCOL` (a TPM 2.0 is
+//! present), the unikernel
+//!
+//! 1. measures what it LOADED — SHA-256 of MODEL.SAF, EMBED.BIN, VOCAB.BIN and
+//!    (if present) RECEIPT.TXT — into **PCR 12**, one event per artifact, as
+//!    `EV_IPL` events whose data is an ASCII line naming the artifact and its
+//!    digest (the same convention systemd-stub uses for the kernel command
+//!    line and initrd it loads);
+//! 2. measures what HAPPENED — the CIS-1 witness chain and verdict of the
+//!    receipt it verified or minted — into **PCR 13**;
+//! 3. reads PCRs 4 (the firmware's own measurement of BOOTX64.EFI), 12 and 13
+//!    back through `TPM2_PCR_Read`, dumps the TCG event log entries for those
+//!    PCRs, and writes `ATTEST.TXT` next to `BOOTLOG.TXT`.
+//!
+//! A remote verifier therefore gets, from one file: the firmware chain
+//! (PCR 0-7, including the exact unikernel binary in PCR 4), the exact model
+//! artifact bytes (PCR 12), and the exact inference transcript commitment
+//! (PCR 13) — each replayable from the event log, and (step 4, `tpm2min`,
+//! separate lab) signable by the TPM as a quote. No operating system is in the
+//! trusted computing base at any point.
+//!
+//! Identity/correctness module only (Rule A): prints no timing, ever.
+
+use aegis_core::witness::{hex_lower, sha256};
+use alloc::boxed::Box;
+use alloc::format;
+use alloc::string::String;
+use alloc::vec;
+use alloc::vec::Vec;
+use tpm2min::cmd::SigScheme;
+use tpm2min::{PcrSelection, PcrSelectionList};
+use uefi::boot::{OpenProtocolAttributes, OpenProtocolParams, ScopedProtocol};
+use uefi::proto::tcg::v2::{HashLogExtendEventFlags, PcrEventInputs, Tcg};
+use uefi::proto::tcg::{AlgorithmId, EventType, PcrIndex};
+
+/// PCR holding the payload measurements (what was loaded).
+pub const PCR_PAYLOAD: u32 = 12;
+/// PCR holding the inference transcript commitment (what happened).
+pub const PCR_RECEIPT: u32 = 13;
+/// PCR the firmware uses for the booted EFI application (PC Client spec).
+pub const PCR_BOOT_APP: u32 = 4;
+
+fn hex32(d: &[u8; 32]) -> String {
+    let mut buf = [0u8; 64];
+    let n = hex_lower(d, &mut buf);
+    String::from_utf8_lossy(&buf[..n]).into_owned()
+}
+
+fn hex(d: &[u8]) -> String {
+    let mut buf = vec![0u8; d.len() * 2];
+    let n = hex_lower(d, &mut buf);
+    String::from_utf8_lossy(&buf[..n]).into_owned()
+}
+
+pub struct Attestor {
+    tcg: ScopedProtocol<Tcg>,
+    /// Every measurement line this boot extended, in order, for BOOTLOG and
+    /// ATTEST.TXT. The verifier replays PCR 12/13 from exactly these lines.
+    pub measured: Vec<(u32, String)>,
+    pub errors: Vec<String>,
+}
+
+impl Attestor {
+    /// `None` when the firmware exposes no TCG2 protocol (no TPM, or TPM
+    /// disabled in setup). The caller logs that as a finding, not an error.
+    pub fn open() -> Option<Self> {
+        let handle = uefi::boot::get_handle_for_protocol::<Tcg>().ok()?;
+        // SAFETY: GET_PROTOCOL open — read-only sharing with whatever agent
+        // already holds the TCG2 protocol (the firmware's own TPM driver); we
+        // never close or uninstall it.
+        let tcg = unsafe {
+            uefi::boot::open_protocol::<Tcg>(
+                OpenProtocolParams {
+                    handle,
+                    agent: uefi::boot::image_handle(),
+                    controller: None,
+                },
+                OpenProtocolAttributes::GetProtocol,
+            )
+        }
+        .ok()?;
+        Some(Attestor {
+            tcg,
+            measured: Vec::new(),
+            errors: Vec::new(),
+        })
+    }
+
+    /// Extend `pcr` with SHA-256(`line`) and log the line as an EV_IPL event.
+    /// The firmware hashes `line` itself (TCG2 HashLogExtendEvent), so the
+    /// PCR value is replayable from the event log alone.
+    pub fn extend(&mut self, pcr: u32, line: &str) -> bool {
+        let event: Box<PcrEventInputs> =
+            match PcrEventInputs::new_in_box(PcrIndex(pcr), EventType::IPL, line.as_bytes()) {
+                Ok(e) => e,
+                Err(e) => {
+                    self.errors
+                        .push(format!("extend pcr{pcr}: event alloc failed ({e:?})"));
+                    return false;
+                }
+            };
+        match self.tcg.hash_log_extend_event(
+            HashLogExtendEventFlags::empty(),
+            line.as_bytes(),
+            &event,
+        ) {
+            Ok(()) => {
+                self.measured.push((pcr, String::from(line)));
+                true
+            }
+            Err(e) => {
+                self.errors.push(format!("extend pcr{pcr}: {e:?}"));
+                false
+            }
+        }
+    }
+
+    /// Measure the three model artifacts (and the receipt, if any) into
+    /// PCR 12. Returns the artifact digests for reuse.
+    pub fn measure_artifacts(
+        &mut self,
+        model: &[u8],
+        embed: &[u8],
+        vocab: &[u8],
+        receipt: Option<&[u8]>,
+    ) -> ([u8; 32], [u8; 32], [u8; 32]) {
+        let m = sha256(model);
+        let e = sha256(embed);
+        let v = sha256(vocab);
+        for (name, len, d) in [
+            ("MODEL.SAF", model.len(), &m),
+            ("EMBED.BIN", embed.len(), &e),
+            ("VOCAB.BIN", vocab.len(), &v),
+        ] {
+            let line = format!(
+                "AEGIS-MEASURE v0 artifact={name} bytes={len} sha256={}",
+                hex32(d)
+            );
+            self.extend(PCR_PAYLOAD, &line);
+        }
+        if let Some(r) = receipt {
+            let line = format!(
+                "AEGIS-MEASURE v0 artifact=RECEIPT.TXT bytes={} sha256={}",
+                r.len(),
+                hex32(&sha256(r))
+            );
+            self.extend(PCR_PAYLOAD, &line);
+        }
+        (m, e, v)
+    }
+
+    /// Commit the inference transcript to PCR 13: the witness chain (a
+    /// SHA-256 over every decode step's token id AND full i64 logit vector),
+    /// the token-sequence digest, the step count, and the mode/verdict.
+    pub fn record_receipt(
+        &mut self,
+        mode: &str,
+        chain: &[u8; 32],
+        cis_digest: u64,
+        steps: usize,
+        verdict: &str,
+    ) {
+        let line = format!(
+            "AEGIS-RECEIPT v0 mode={mode} steps={steps} cis-digest={cis_digest:016x} chain={} verdict={verdict}",
+            hex32(chain)
+        );
+        self.extend(PCR_RECEIPT, &line);
+    }
+
+    /// TPM2_PCR_Read (TPM 2.0 Part 3 §22.4) for SHA-256 PCRs `pcrs` (≤ 8).
+    /// Returns `(pcr, digest)` pairs in selection order, or an error string.
+    pub fn pcr_read(&mut self, pcrs: &[u32]) -> Result<Vec<(u32, [u8; 32])>, String> {
+        if pcrs.is_empty() || pcrs.len() > 8 || pcrs.iter().any(|&p| p >= 24) {
+            return Err(String::from("pcr_read: bad selection"));
+        }
+        let mut select = [0u8; 3];
+        for &p in pcrs {
+            select[(p / 8) as usize] |= 1 << (p % 8);
+        }
+        // TPM2_PCR_Read: TPMI_ST_COMMAND_TAG (TPM_ST_NO_SESSIONS = 0x8001),
+        // commandSize, commandCode 0x0000017E, TPML_PCR_SELECTION{count=1,
+        // {hash=TPM_ALG_SHA256 0x000B, sizeofSelect=3, pcrSelect[3]}}.
+        let mut cmd: Vec<u8> = Vec::with_capacity(20);
+        cmd.extend_from_slice(&0x8001u16.to_be_bytes());
+        cmd.extend_from_slice(&0u32.to_be_bytes()); // size, patched below
+        cmd.extend_from_slice(&0x0000_017Eu32.to_be_bytes());
+        cmd.extend_from_slice(&1u32.to_be_bytes());
+        cmd.extend_from_slice(&0x000Bu16.to_be_bytes());
+        cmd.push(3);
+        cmd.extend_from_slice(&select);
+        let n = cmd.len() as u32;
+        cmd[2..6].copy_from_slice(&n.to_be_bytes());
+
+        let mut rsp = vec![0u8; 1024];
+        self.tcg
+            .submit_command(&cmd, &mut rsp)
+            .map_err(|e| format!("pcr_read: submit_command {e:?}"))?;
+        // Response: tag u16, size u32, rc u32, pcrUpdateCounter u32,
+        // TPML_PCR_SELECTION, TPML_DIGEST{count u32, TPM2B_DIGEST{size u16, buf}...}
+        let be32 = |b: &[u8], o: usize| u32::from_be_bytes([b[o], b[o + 1], b[o + 2], b[o + 3]]);
+        let be16 = |b: &[u8], o: usize| u16::from_be_bytes([b[o], b[o + 1]]);
+        let size = be32(&rsp, 2) as usize;
+        if size < 10 || size > rsp.len() {
+            return Err(format!("pcr_read: bad response size {size}"));
+        }
+        let rc = be32(&rsp, 6);
+        if rc != 0 {
+            return Err(format!("pcr_read: TPM_RC 0x{rc:08x}"));
+        }
+        let mut o = 14usize; // past pcrUpdateCounter
+        let sel_count = be32(&rsp, o) as usize;
+        o += 4;
+        for _ in 0..sel_count {
+            o += 2; // hash alg
+            let sz = rsp[o] as usize;
+            o += 1 + sz;
+        }
+        let dcount = be32(&rsp, o) as usize;
+        o += 4;
+        if dcount != pcrs.len() {
+            return Err(format!(
+                "pcr_read: TPM returned {dcount} digests for {} PCRs (bank not SHA-256?)",
+                pcrs.len()
+            ));
+        }
+        let mut out = Vec::with_capacity(dcount);
+        for &p in pcrs {
+            let dsz = be16(&rsp, o) as usize;
+            o += 2;
+            if dsz != 32 || o + 32 > size {
+                return Err(format!("pcr_read: digest size {dsz} at offset {o}"));
+            }
+            let mut d = [0u8; 32];
+            d.copy_from_slice(&rsp[o..o + 32]);
+            o += 32;
+            out.push((p, d));
+        }
+        Ok(out)
+    }
+
+    /// TCG2 event-log (crypto-agile format) entries for PCRs 4, 12 and 13:
+    /// one line each, `event pcr=<n> type=0x<t> sha256=<hex> data=<ascii|hex>`.
+    pub fn event_log_lines(&mut self) -> Vec<String> {
+        let mut lines = Vec::new();
+        let log = match self.tcg.get_event_log_v2() {
+            Ok(l) => l,
+            Err(e) => {
+                lines.push(format!("eventlog: unavailable ({e:?})"));
+                return lines;
+            }
+        };
+        for ev in log.iter() {
+            let pcr = ev.pcr_index().0;
+            if pcr != PCR_BOOT_APP && pcr != PCR_PAYLOAD && pcr != PCR_RECEIPT {
+                continue;
+            }
+            let mut sha = String::from("-");
+            for (alg, digest) in ev.digests() {
+                if alg == AlgorithmId::SHA256 {
+                    sha = hex(digest);
+                }
+            }
+            let data = ev.event_data();
+            let printable = data.iter().all(|&b| (0x20..0x7f).contains(&b));
+            let shown = if printable && !data.is_empty() {
+                String::from_utf8_lossy(data).into_owned()
+            } else {
+                format!("hex:{}", hex(&data[..data.len().min(96)]))
+            };
+            lines.push(format!(
+                "event pcr={pcr} type=0x{:x} sha256={sha} data={shown}",
+                ev.event_type().0
+            ));
+        }
+        if log.is_truncated() {
+            lines.push(String::from("eventlog: TRUNCATED by firmware"));
+        }
+        lines
+    }
+
+    /// Compose ATTEST.TXT: machine identity, every measurement line, the
+    /// event-log excerpt, and the live PCR values.
+    pub fn report(&mut self, cpuid_line: &str, qualifying: Option<&[u8; 32]>) -> String {
+        let mut s = String::new();
+        s.push_str("AEGIS-ATTEST v0\n");
+        s.push_str(&format!("{cpuid_line}\n"));
+        s.push_str("pcr-bank sha256\n");
+        for (pcr, line) in &self.measured {
+            s.push_str(&format!("measured pcr={pcr} {line}\n"));
+        }
+        for l in self.event_log_lines() {
+            s.push_str(&l);
+            s.push('\n');
+        }
+        match self.pcr_read(&[PCR_BOOT_APP, PCR_PAYLOAD, PCR_RECEIPT]) {
+            Ok(v) => {
+                for (p, d) in v {
+                    s.push_str(&format!("pcr {p} {}\n", hex32(&d)));
+                }
+            }
+            Err(e) => s.push_str(&format!("pcr-read-error {e}\n")),
+        }
+        if let Some(q) = qualifying {
+            match self.quote(q) {
+                Ok(qo) => {
+                    s.push_str(&format!(
+                        "quote-pcrs {},{},{}\n",
+                        qo.pcrs[0], qo.pcrs[1], qo.pcrs[2]
+                    ));
+                    s.push_str(&format!("quote-qualifying {}\n", hex32(&qo.qualifying)));
+                    s.push_str(&format!("quote-pub-x {}\n", hex32(&qo.pub_x)));
+                    s.push_str(&format!("quote-pub-y {}\n", hex32(&qo.pub_y)));
+                    s.push_str(&format!("quote-public {}\n", hex(&qo.public_raw)));
+                    s.push_str(&format!("quote-attest {}\n", hex(&qo.attest)));
+                    s.push_str(&format!("quote-sig-r {}\n", hex32(&qo.sig_r)));
+                    s.push_str(&format!("quote-sig-s {}\n", hex32(&qo.sig_s)));
+                    s.push_str(&format!("quote-retries {}\n", qo.retries));
+                    s.push_str(
+                        "quote-key ecc-p256 ecdsa-sha256 owner-hierarchy transient (this boot)\n",
+                    );
+                }
+                Err(e) => s.push_str(&format!("quote-error {e}\n")),
+            }
+        }
+        for e in &self.errors {
+            s.push_str(&format!("error {e}\n"));
+        }
+        s
+    }
+}
+
+/// A TPM quote over PCRs 4, 12 and 13, signed by a TPM-resident ECC P-256
+/// attestation key created under the owner hierarchy for this boot.
+pub struct QuoteOut {
+    pub pub_x: [u8; 32],
+    pub pub_y: [u8; 32],
+    /// Raw `TPMT_PUBLIC` of the signing key (what `tpm2_readpublic -o` emits
+    /// minus the 2-byte size prefix).
+    pub public_raw: Vec<u8>,
+    /// Raw `TPMS_ATTEST` (the signed bytes).
+    pub attest: Vec<u8>,
+    pub sig_r: [u8; 32],
+    pub sig_s: [u8; 32],
+    pub qualifying: [u8; 32],
+    pub pcrs: [u32; 3],
+    pub retries: u32,
+}
+
+impl Attestor {
+    /// Submit a raw TPM 2.0 command through EFI_TCG2_PROTOCOL and return the
+    /// response slice. Resends (bounded) on the TPM's warning-class "retry"
+    /// codes: on every fresh swtpm/libtpms the first TPM2_Quote after Startup
+    /// answers TPM_RC_RETRY (0x922) and succeeds when re-sent unchanged —
+    /// tpm2-tss and the Linux TPM driver do this resend transparently, the
+    /// TCG2 protocol does not (lab finding 2026-10-06, tpm2min RESULT.md).
+    fn submit<'r>(&mut self, cmd: &[u8], rsp: &'r mut [u8]) -> Result<(&'r [u8], u32), String> {
+        let mut retries = 0u32;
+        loop {
+            for b in rsp.iter_mut() {
+                *b = 0;
+            }
+            self.tcg
+                .submit_command(cmd, rsp)
+                .map_err(|e| format!("submit_command {e:?}"))?;
+            let size = u32::from_be_bytes([rsp[2], rsp[3], rsp[4], rsp[5]]) as usize;
+            if size < 10 || size > rsp.len() {
+                return Err(format!("response size {size} out of range"));
+            }
+            let rc = u32::from_be_bytes([rsp[6], rsp[7], rsp[8], rsp[9]]);
+            if tpm2min::Error::TpmRc(rc).is_retryable() && retries < 8 {
+                retries += 1;
+                continue;
+            }
+            // Re-borrow after the loop decides; the slice lives as long as `rsp`.
+            let out: &'r [u8] = unsafe { core::slice::from_raw_parts(rsp.as_ptr(), size) };
+            return Ok((out, retries));
+        }
+    }
+
+    /// CreatePrimary (owner, ECC P-256 ECDSA/SHA-256, restricted signing key)
+    /// -> Quote(PCR 4,12,13 SHA-256, qualifyingData) -> FlushContext.
+    pub fn quote(&mut self, qualifying: &[u8; 32]) -> Result<QuoteOut, String> {
+        let mut cmd = [0u8; tpm2min::COMMAND_BUFFER_SIZE];
+        let mut rsp = vec![0u8; tpm2min::RESPONSE_BUFFER_SIZE];
+        let n = tpm2min::cmd::create_primary_ecc_p256(&mut cmd, tpm2min::consts::TPM_RH_OWNER)
+            .map_err(|e| format!("create_primary build {e:?}"))?;
+        let (r, retries_a) = self.submit(&cmd[..n], &mut rsp)?;
+        let cp = tpm2min::rsp::create_primary(r).map_err(|e| format!("create_primary {e:?}"))?;
+        let ecc = tpm2min::rsp::ecc_public(cp.public.as_slice())
+            .map_err(|e| format!("ecc_public {e:?}"))?;
+        let handle = cp.handle;
+        let public_raw = cp.public.as_slice().to_vec();
+
+        let sel = PcrSelectionList::single(PcrSelection::sha256(&[
+            PCR_BOOT_APP as u8,
+            PCR_PAYLOAD as u8,
+            PCR_RECEIPT as u8,
+        ]));
+        let n = tpm2min::cmd::quote(&mut cmd, handle, qualifying, SigScheme::Null, &sel)
+            .map_err(|e| format!("quote build {e:?}"))?;
+        let quote_res = self.submit(&cmd[..n], &mut rsp);
+        // Always flush the transient key, even if the quote failed.
+        let mut flush = [0u8; 32];
+        if let Ok(m) = tpm2min::cmd::flush_context(&mut flush, handle) {
+            let mut frsp = [0u8; 64];
+            let _ = self.tcg.submit_command(&flush[..m], &mut frsp);
+        }
+        let (r, retries_b) = quote_res?;
+        let q = tpm2min::rsp::quote(r).map_err(|e| format!("quote parse {e:?}"))?;
+        // Sanity-parse the attestation structure before reporting it.
+        let a =
+            tpm2min::rsp::attest(q.attest.as_slice()).map_err(|e| format!("attest parse {e:?}"))?;
+        if a.extra_data.as_slice() != qualifying {
+            return Err(String::from("quote extraData != qualifyingData"));
+        }
+        Ok(QuoteOut {
+            pub_x: ecc.x,
+            pub_y: ecc.y,
+            public_raw,
+            attest: q.attest.as_slice().to_vec(),
+            sig_r: q.signature.r,
+            sig_s: q.signature.s,
+            qualifying: *qualifying,
+            pcrs: [PCR_BOOT_APP, PCR_PAYLOAD, PCR_RECEIPT],
+            retries: retries_a + retries_b,
+        })
+    }
+}
+
+/// Host-side replay rule, stated here so the verifier and the unikernel agree:
+/// `PCR_n = SHA256(PCR_{n-1} || SHA256(line_n))` starting from 32 zero bytes,
+/// over the `measured pcr=<n>` lines of ATTEST.TXT in order (for PCR 12 and
+/// 13; PCR 4's events are the firmware's and replay from the event log's own
+/// digests). Pure function, used by the self-check below.
+pub fn replay_pcr(lines: &[&str]) -> [u8; 32] {
+    let mut pcr = [0u8; 32];
+    for l in lines {
+        let d = sha256(l.as_bytes());
+        let mut cat = [0u8; 64];
+        cat[..32].copy_from_slice(&pcr);
+        cat[32..].copy_from_slice(&d);
+        pcr = sha256(&cat);
+    }
+    pcr
+}
