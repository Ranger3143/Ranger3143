+/// Write (create or replace) a whole file on the boot volume. Used for
+/// ATTEST.TXT and a minted RECEIPT.TXT — artifacts a verifier reads back.
+fn write_whole_file(
+    root: &mut uefi::proto::media::file::Directory,
+    name: &str,
+    data: &[u8],
+) -> bool {
+    use uefi::proto::media::file::{File, FileAttribute, FileMode, FileType};
+    let mut buf = [0u16; 32];
+    let Ok(cstr) = uefi::CStr16::from_str_with_buf(name, &mut buf) else {
+        return false;
+    };
+    // Replace semantics: delete a stale copy first (ignore "not found").
+    if let Ok(h) = root.open(cstr, FileMode::CreateReadWrite, FileAttribute::empty())
+        && let Ok(FileType::Regular(f)) = h.into_type()
+    {
+        let _ = f.delete();
+    }
+    let Ok(h) = root.open(cstr, FileMode::CreateReadWrite, FileAttribute::empty()) else {
+        return false;
+    };
+    let Ok(FileType::Regular(mut f)) = h.into_type() else {
+        return false;
+    };
+    let ok = f.write(data).is_ok() && f.flush().is_ok();
+    f.close();
+    ok
+}
