@@ -0,0 +1,88 @@
+//! cis_vnni must be byte-identical to the CIS-1 scalar reference for every
+//! input, on every shape class the engine uses, including the paths where it
+//! falls back (small shapes, `-128` activations, VNNI forced off).
+#![cfg(all(target_arch = "x86_64", not(target_os = "uefi")))]
+
+use aegis_core::cis::ternary_matvec_i8;
+use aegis_core::cis_vnni::{set_force_no_vnni, ternary_matvec_i8_vnni, vnni_level_name};
+
+fn lcg(state: &mut u64) -> u64 {
+    *state = state
+        .wrapping_mul(6364136223846793005)
+        .wrapping_add(1442695040888963407);
+    *state
+}
+
+fn case(dim_out: usize, dim_in: usize, seed: u64, allow_min: bool) {
+    let mut st = seed;
+    let n_bytes = dim_in / 4;
+    let mut input = vec![0i8; dim_in];
+    for x in input.iter_mut() {
+        let v = ((lcg(&mut st) >> 40) % 255) as i32 - 127;
+        *x = v as i8;
+    }
+    if allow_min {
+        input[dim_in / 2] = i8::MIN;
+    }
+    let mut w = vec![0u8; dim_out * n_bytes];
+    for b in w.iter_mut() {
+        *b = (lcg(&mut st) & 0xFF) as u8; // includes code 11 (defined-as-zero)
+    }
+    let mut want = vec![0i32; dim_out];
+    let mut got = vec![0i32; dim_out];
+    ternary_matvec_i8(&mut want, &input, &w, dim_out, dim_in);
+    ternary_matvec_i8_vnni(&mut got, &input, &w, dim_out, dim_in);
+    assert_eq!(
+        want,
+        got,
+        "cis_vnni diverged from scalar reference at {dim_out}x{dim_in} (level {})",
+        vnni_level_name()
+    );
+}
+
+#[test]
+fn vnni_matches_reference_on_engine_shapes() {
+    // BitNet-2B-4T: q/o 2560x2560, k/v 640x2560, gate/up 6912x2560, down 2560x6912;
+    // M7-class 384-wide; Falcon-E 2048/8192-class; plus odd tails.
+    for &(o, i) in &[
+        (2560usize, 2560usize),
+        (640, 2560),
+        (6912, 2560),
+        (2560, 6912),
+        (384, 384),
+        (1024, 384),
+        (2048, 2048),
+        (8192, 2048),
+        (7, 4),
+        (3, 132),
+        (5, 260),
+        (9, 1028),
+        (2, 4096 + 4),
+    ] {
+        case(o, i, 0x5EED_0000 + (o * 31 + i) as u64, false);
+    }
+}
+
+#[test]
+fn vnni_minus128_hazard_routes_to_reference() {
+    case(2560, 2560, 0xA5A5, true);
+    case(640, 6912, 0xB6B6, true);
+}
+
+#[test]
+fn vnni_forced_off_still_matches_reference() {
+    set_force_no_vnni(true);
+    case(2560, 2560, 0xC7C7, false);
+    case(2560, 6912, 0xD8D8, false);
+    set_force_no_vnni(false);
+}
+
+#[test]
+fn vnni_rejects_exactly_the_reference_rejection_surface() {
+    // dim_in not a multiple of 4 must panic before any dispatch (spec §5.1).
+    let r = std::panic::catch_unwind(|| {
+        let mut out = vec![0i32; 4];
+        ternary_matvec_i8_vnni(&mut out, &[1i8; 10], &[0u8; 12], 4, 10);
+    });
+    assert!(r.is_err(), "dim_in=10 must be rejected");
+}
