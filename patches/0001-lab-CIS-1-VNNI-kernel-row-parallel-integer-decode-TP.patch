+    #[test]
+    fn ecc_public_parses_point() {
+        let x: [u8; 32] = core::array::from_fn(|i| i as u8);
+        let y: [u8; 32] = core::array::from_fn(|i| 0xff - i as u8);
+        let p = ecc_tpmt_public(&x, &y);
