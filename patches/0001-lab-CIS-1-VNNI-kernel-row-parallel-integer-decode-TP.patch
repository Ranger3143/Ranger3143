+}
+
+fn fail(detail: String) -> Verdict {
+    Verdict {
+        pass: false,
+        detail,
+        chain: None,
+        cis_digest: 0,
+        steps: 0,
+    }
+}
+
+/// Outcome of one deterministic CIS-1 FullInt greedy decode.
+pub struct Replay {
+    pub prompt_toks: usize,
+    pub generated: Vec<u32>,
+    pub fnv: u64,
+    pub chain: [u8; 32],
+}
+
+/// The deterministic decode `run` (verify) and `mint` share — step order and
+/// digest folds are EXACTLY `aegis-linux/examples/cis_witness.rs`'s, so a
+/// receipt minted here verifies with the Linux tools and vice versa.
+pub fn replay(
+    model: &[u8],
+    embed: &[u8],
+    vocab: &[u8],
+    hashes: (&[u8; 32], &[u8; 32], &[u8; 32]),
+    prompt: &str,
+    max_new: usize,
+) -> Result<Replay, &'static str> {
+    let tensors = SafeTensors::deserialize(model).map_err(|_| "MODEL.SAF did not parse")?;
+    let config = tensors
+        .metadata_field("aegis_config")
+        .ok()
+        .flatten()
+        .and_then(|j| ModelConfig::from_json(&j).ok())
+        .ok_or("MODEL.SAF carries no parseable aegis_config")?;
+    let pipeline =
+        FullBitNetPipeline::new(&tensors, embed, &config).map_err(|_| "pipeline build")?;
+    let cis_model = CisModel::new(&pipeline, &config).map_err(|_| "CIS model conversion")?;
+    let mut engine = CisEngine::new_with_mode(&cis_model, CisMode::FullInt);
+    let tokenizer = AegisTokenizer::new(vocab).map_err(|_| "VOCAB.BIN did not parse")?;
+    let prompt_ids = tokenizer.encode(prompt);
+    if prompt_ids.is_empty() || prompt_ids.len() + max_new > config.max_position_embeddings {
+        return Err("prompt empty or exceeds context");
+    }
+    let header = WitnessHeader {
+        model_sha: hashes.0,
+        embed_sha: hashes.1,
+        vocab_sha: hashes.2,
+        max_new: max_new as u64,
+        prompt: prompt.as_bytes(),
+    };
+    let mut fnv: u64 = 0xcbf2_9ce4_8422_2325;
+    let mut chain = WitnessChain::from_header(&header);
+    let mut pos = 0usize;
+    for &t in &prompt_ids {
+        fnv = fnv1a64(fnv, &t.to_le_bytes());
+        engine.forward_step_int(t, pos);
+        pos += 1;
+    }
+    let mut generated: Vec<u32> = Vec::with_capacity(max_new);
+    for _ in 0..max_new {
+        let tok = {
+            let logits = engine.decode_logits();
+            let t = argmax_i64(logits);
+            chain.fold_step(t, logits);
+            t
+        };
+        fnv = fnv1a64(fnv, &tok.to_le_bytes());
+        generated.push(tok);
+        engine.forward_step_int(tok, pos);
+        pos += 1;
+    }
+    Ok(Replay {
+        prompt_toks: prompt_ids.len(),
+        generated,
+        fnv,
+        chain: chain.digest(),
+    })
+}
+
+/// Render a witness v1 receipt exactly as `cis_witness gen` prints it (LF
+/// line endings, same key order), so the Linux verifiers accept it unchanged.
+pub fn render_receipt(
+    hashes: (&[u8; 32], &[u8; 32], &[u8; 32]),
+    prompt: &str,
+    max_new: usize,
+    r: &Replay,
+) -> String {
+    let mut s = String::new();
+    let _ = writeln!(s, "AEGIS-WITNESS v1-CIS");
+    let _ = writeln!(s, "model {}", hex32(hashes.0));
+    let _ = writeln!(s, "embed {}", hex32(hashes.1));
+    let _ = writeln!(s, "vocab {}", hex32(hashes.2));
+    let _ = writeln!(s, "maxtok {max_new}");
+    let mut ph = vec![0u8; prompt.len() * 2];
+    let n = hex_lower(prompt.as_bytes(), &mut ph);
+    let _ = writeln!(s, "prompt-hex {}", String::from_utf8_lossy(&ph[..n]));
+    let _ = writeln!(s, "prompt-toks {}", r.prompt_toks);
+    let _ = writeln!(s, "gen-toks {}", r.generated.len());
+    let ids: Vec<String> = r.generated.iter().map(|t| format!("{t}")).collect();
+    let _ = writeln!(s, "token-ids {}", ids.join(","));
+    let _ = writeln!(s, "cis-digest {:016x}", r.fnv);
+    let _ = writeln!(s, "chain {}", hex32(&r.chain));
+    s
 }
 
