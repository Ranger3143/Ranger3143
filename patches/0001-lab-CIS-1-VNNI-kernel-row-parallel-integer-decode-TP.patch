diff --git a/aegis-core/benches/vnni_vs_avx2.rs b/aegis-core/benches/vnni_vs_avx2.rs
new file mode 100644
index 0000000..88e01fb
--- /dev/null
+++ b/aegis-core/benches/vnni_vs_avx2.rs
@@ -0,0 +1,176 @@
+//! vnni_vs_avx2 — same-process, interleaved A/B of the CIS-1 integer ternary
+//! matvec: incumbent AVX2 v3b (`cis_avx2::ternary_matvec_i8_avx2`) vs the VNNI
+//! kernel (`cis_vnni::ternary_matvec_i8_vnni`, zmm or ymm by capability), on
+//! the BitNet-2B-4T shapes. Bit-identity to the scalar reference is asserted on
+//! every shape before any timing is taken; a mismatch aborts the run.
+//!
+//! Rule A: the machine is named from CPUID and flagged `env=vm` when the
+//! hypervisor bit is set. Absolute figures from a VM are NOT a ceiling and are
+//! not to be quoted as such; the RATIO between two kernels measured
+//! interleaved in the same process on the same data is the robust output.
+//!
+//! Usage: vnni_vs_avx2 [rounds=11] [calls_per_round=20] [stream_mb=0]
+//!   stream_mb > 0: allocate enough DISTINCT copies of each weight matrix to
+//!   cover stream_mb megabytes and rotate through them call by call, so every
+//!   call streams its weights from DRAM the way a decode step does (a single
+//!   resident matrix of 1.6-4.4 MB would otherwise sit in L2/L3 and flatter
+//!   the compute side). Arms: avx2 (incumbent v3b), vnni (default dispatch:
+//!   1-row zmm, or ymm on AVX-VNNI parts), vnni-r4 (4-row-blocked zmm, forced).
+use aegis_core::cis::ternary_matvec_i8;
+use aegis_core::cis_avx2::ternary_matvec_i8_avx2;
+use aegis_core::cis_vnni::{set_force_r4, ternary_matvec_i8_vnni, vnni_level_name};
+use std::time::Instant;
+
+fn lcg(state: &mut u64) -> u64 {
+    *state = state
+        .wrapping_mul(6364136223846793005)
+        .wrapping_add(1442695040888963407);
+    *state
+}
+
+fn cpu_brand() -> String {
+    let mut s = String::new();
+    for leaf in 0x8000_0002u32..=0x8000_0004 {
+        let r = unsafe { core::arch::x86_64::__cpuid(leaf) };
+        for v in [r.eax, r.ebx, r.ecx, r.edx] {
+            s.push_str(&String::from_utf8_lossy(&v.to_le_bytes()));
+        }
+    }
+    s.trim_matches(char::from(0)).trim().to_string()
+}
+
+fn hypervisor() -> bool {
+    let r = unsafe { core::arch::x86_64::__cpuid(1) };
+    (r.ecx >> 31) & 1 == 1
+}
+
+fn median(v: &mut [f64]) -> f64 {
+    v.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    v[v.len() / 2]
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let rounds: usize = args.get(1).and_then(|s| s.parse().ok()).unwrap_or(11);
+    let calls: usize = args.get(2).and_then(|s| s.parse().ok()).unwrap_or(20);
+    let stream_mb: usize = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(0);
+    println!(
+        "VNNI_VS_AVX2 cpu=\"{}\" env={} vnni_level=\"{}\" rounds={} calls_per_round={} stream_mb={}",
+        cpu_brand(),
+        if hypervisor() { "vm" } else { "iron" },
+        vnni_level_name(),
+        rounds,
+        calls,
+        stream_mb
+    );
+    println!(
+        "shape(out x in)  kernel   median_us/call  GMAC/s  weightGB/s  ratio(vs avx2)  bitexact"
+    );
+
+    let shapes = [
+        ("q/o 2560x2560", 2560usize, 2560usize),
+        ("k/v 640x2560", 640, 2560),
+        ("gate/up 6912x2560", 6912, 2560),
+        ("down 2560x6912", 2560, 6912),
+    ];
+    let mut st = 0x0DD5_EED0_1234_5678u64;
+    for (name, dim_out, dim_in) in shapes {
+        let n_bytes = dim_in / 4;
+        let mut input = vec![0i8; dim_in];
+        for x in input.iter_mut() {
+            *x = (((lcg(&mut st) >> 40) % 255) as i32 - 127) as i8;
+        }
+        // Realistic ternary distribution: ~42% zeros (BitNet-2B-4T census), rest +-1.
+        let bytes_per = dim_out * n_bytes;
+        let copies = if stream_mb == 0 {
+            1
+        } else {
+            ((stream_mb << 20) / bytes_per).max(2)
+        };
+        let mut ws: Vec<Vec<u8>> = Vec::with_capacity(copies);
+        for _ in 0..copies {
+            let mut w = vec![0u8; bytes_per];
+            for b in w.iter_mut() {
+                let mut byte = 0u8;
+                for k in 0..4 {
+                    let r = lcg(&mut st) % 100;
+                    let code = if r < 42 {
+                        0
+                    } else if r < 71 {
+                        1
+                    } else {
+                        2
+                    };
+                    byte |= code << (2 * k);
+                }
+                *b = byte;
+            }
+            ws.push(w);
+        }
+        let mut reference = vec![0i32; dim_out];
+        let mut out_a = vec![0i32; dim_out];
+        let mut out_v = vec![0i32; dim_out];
+        let mut out_1 = vec![0i32; dim_out];
+        let mut exact = true;
+        for w in &ws {
+            ternary_matvec_i8(&mut reference, &input, w, dim_out, dim_in);
+            ternary_matvec_i8_avx2(&mut out_a, &input, w, dim_out, dim_in);
+            ternary_matvec_i8_vnni(&mut out_v, &input, w, dim_out, dim_in);
+            set_force_r4(true);
+            ternary_matvec_i8_vnni(&mut out_1, &input, w, dim_out, dim_in);
+            set_force_r4(false);
+            exact &= reference == out_a && reference == out_v && reference == out_1;
+        }
+        if !exact {
+            eprintln!("BIT-EXACTNESS FAILURE on {name}: aborting before any timing");
+            std::process::exit(1);
+        }
+        // Arms: 0 = avx2, 1 = vnni-r1, 2 = vnni (default dispatch).
+        let run_arm =
+            |arm: usize, w: &[u8], out_a: &mut [i32], out_1: &mut [i32], out_v: &mut [i32]| {
+                match arm {
+                    0 => ternary_matvec_i8_avx2(out_a, &input, w, dim_out, dim_in),
+                    1 => ternary_matvec_i8_vnni(out_1, &input, w, dim_out, dim_in),
+                    _ => {
+                        set_force_r4(true);
+                        ternary_matvec_i8_vnni(out_v, &input, w, dim_out, dim_in);
+                        set_force_r4(false);
+                    }
+                }
+            };
+        // Warm-up (first-touch), excluded.
+        for arm in 0..3 {
+            run_arm(arm, &ws[0], &mut out_a, &mut out_1, &mut out_v);
+        }
+        let mut t = [
+            Vec::with_capacity(rounds),
+            Vec::with_capacity(rounds),
+            Vec::with_capacity(rounds),
+        ];
+        let mut wi = 0usize;
+        for r in 0..rounds {
+            // Rotate arm order every round so drift/turbo bias cancels.
+            let order = [[0, 1, 2], [1, 2, 0], [2, 0, 1]][r % 3];
+            for &arm in &order {
+                let t0 = Instant::now();
+                for _ in 0..calls {
+                    wi = (wi + 1) % copies;
+                    run_arm(arm, &ws[wi], &mut out_a, &mut out_1, &mut out_v);
+                }
+                t[arm].push(t0.elapsed().as_secs_f64() * 1e6 / calls as f64);
+            }
+        }
+        let m: Vec<f64> = t.iter_mut().map(|v| median(v)).collect();
+        let macs = (dim_out * dim_in) as f64;
+        for (arm, label) in ["avx2", "vnni", "vnni-r4"].iter().enumerate() {
+            println!(
+                "{name:<20} {label:<8} {:>10.1}  {:>6.2}  {:>8.2}  {:>6.3}  {}",
+                m[arm],
+                macs / m[arm] / 1e3,
+                bytes_per as f64 / m[arm] / 1e3,
+                m[0] / m[arm],
+                exact
+            );
+        }
+    }
+}
