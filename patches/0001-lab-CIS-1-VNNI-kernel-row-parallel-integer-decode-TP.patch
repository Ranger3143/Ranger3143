 // `scripts/cis_e2_golden_gen.py` (Python arbitrary-precision integers,
 // scripted from the same spec text) — never by the Rust under test.
 // ---------------------------------------------------------------------------
+
+/// Smallest CIS matvec worth fanning out (same threshold spirit as
+/// `ops::PARALLEL_MIN_MACS`): below this the broadcast barrier costs more than
+/// the rows. k/v_proj at 640x2560 = 1.6M MACs is the smallest shape that
+/// qualifies in BitNet-2B-4T.
+#[cfg(feature = "parallel")]
+const CIS_PARALLEL_MIN_MACS: usize = 1 << 20;
+
+/// Disjoint row range for worker `id` of `n` (plain split; the CIS kernels have
+/// no row-unroll alignment requirement).
+#[cfg(feature = "parallel")]
+#[inline]
+fn cis_row_split(dim_out: usize, id: usize, n: usize) -> (usize, usize) {
+    let per = dim_out.div_ceil(n).max(1);
+    let row0 = id * per;
+    if row0 >= dim_out {
+        return (dim_out, 0);
+    }
+    (row0, core::cmp::min(per, dim_out - row0))
+}
+
+/// Send-able base pointer for an i32 output buffer that workers slice disjointly.
+#[cfg(feature = "parallel")]
+#[derive(Clone, Copy)]
+struct CisOutPtr(*mut i32);
+#[cfg(feature = "parallel")]
+impl CisOutPtr {
+    #[inline(always)]
+    fn get(self) -> *mut i32 {
+        self.0
+    }
+}
+#[cfg(feature = "parallel")]
+unsafe impl Send for CisOutPtr {}
+#[cfg(feature = "parallel")]
+unsafe impl Sync for CisOutPtr {}
+
+/// Send-able base pointer for the i64 logits the LM-head workers fill disjointly.
+#[cfg(feature = "parallel")]
+#[derive(Clone, Copy)]
+struct CisLogitPtr(*mut i64);
+#[cfg(feature = "parallel")]
+impl CisLogitPtr {
+    #[inline(always)]
+    fn get(self) -> *mut i64 {
+        self.0
+    }
+}
+#[cfg(feature = "parallel")]
+unsafe impl Send for CisLogitPtr {}
+#[cfg(feature = "parallel")]
+unsafe impl Sync for CisLogitPtr {}
+
