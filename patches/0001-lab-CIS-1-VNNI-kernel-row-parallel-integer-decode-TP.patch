+    fn rsp(tag: u16, rc: u32, body: &[u8]) -> ([u8; 1024], usize) {
+        let mut b = [0u8; 1024];
+        let n = {
+            let mut w = Writer::new(&mut b);
+            w.put_u16(tag).unwrap();
+            w.put_u32((10 + body.len()) as u32).unwrap();
+            w.put_u32(rc).unwrap();
+            w.put_bytes(body).unwrap();
+            w.finish()
+        };
