+        assert_eq!(parse_lenient(&m7().replace('\n', "\r\n")).unwrap(), want);
+        let nofinal = &m7()[..m7().len() - 1];
+        assert_eq!(parse_lenient(nofinal).unwrap(), want);
+        let plus = m7().replace("maxtok 64", "maxtok +64");
+        assert_eq!(parse_lenient(&plus).unwrap(), want);
+        let zero = m7().replace("maxtok 64", "maxtok 064");
+        assert_eq!(parse_lenient(&zero).unwrap(), want);
+        // prompt-toks / gen-toks are never read by the default reader.
+        let counts = m7()
+            .replace("prompt-toks 4", "prompt-toks 99")
+            .replace("gen-toks 64", "gen-toks 1");
