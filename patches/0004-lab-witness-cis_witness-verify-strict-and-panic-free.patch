+            "maxtok 99999999999999999999999999\n",
+            "token-ids 1,x\n",
+            "token-ids 1,-2\n",
+            "token-ids 4294967296\n",
+            "prompt-hex ff\n",
+            "prompt-hex c3\n",
+            "prompt-hex aé\n",
+            "prompt-hex aéé\n",
+        ] {
+            assert!(parse_lenient(bad).is_err(), "{bad:?}");
+        }
+        // Not a panic and not an error: legacy leniency (a non-hex pair, even a
+        // whole multi-byte character, decodes to 0).
+        assert_eq!(parse_lenient("prompt-hex zz4f\n").unwrap().prompt, "\0O");
+        assert_eq!(parse_lenient("prompt-hex ééé\n").unwrap().prompt, "\0\0\0");
+        for (_, text) in GOLDENS {
+            for cut in 0..=text.len() {
+                if let Some(t) = text.get(..cut) {
+                    let _ = parse_lenient(t);
+                }
+                let _ = parse_strict(&text.as_bytes()[..cut]);
+            }
+        }
+        let junk: [&[u8]; 6] = [
+            b"",
+            b"\n",
+            b"\xff\xfe",
+            b"\0\0\0",
+            b"a b c\n\n\n",
+            b"\r\r\n\n",
+        ];
+        for j in junk {
+            let _ = parse_strict(j);
+            if let Ok(t) = std::str::from_utf8(j) {
+                let _ = parse_lenient(t);
+            }
+        }
+    }
+
+    #[test]
+    fn unhex_lenient_keeps_its_semantics() {
+        assert_eq!(unhex_lenient("4f6e").unwrap(), b"On");
+        assert_eq!(unhex_lenient("4F6E").unwrap(), b"On");
+        assert_eq!(unhex_lenient("4f6").unwrap(), b"O"); // odd tail dropped
+        assert_eq!(unhex_lenient("+a").unwrap(), [10]);
+        assert_eq!(unhex_lenient("zz").unwrap(), [0]);
+        assert_eq!(unhex_lenient("").unwrap(), b"");
+        assert_eq!(unhex_lenient("é").unwrap(), [0]); // a whole character is one non-hex pair
+        assert!(unhex_lenient("aé").is_err()); // a pair that splits a character
+    }
+
+    #[test]
+    fn prefix16_cuts_on_a_character_boundary() {
+        assert_eq!(prefix16("abc"), "abc");
+        assert_eq!(prefix16("0123456789abcdefXYZ"), "0123456789abcdef");
+        let s = "0123456789abcde\u{e9}tail"; // byte 16 is inside the 2-byte e-acute
+        assert_eq!(prefix16(s), "0123456789abcde");
+        assert_eq!(prefix16(""), "");
+    }
+
+    #[test]
+    fn strict_helpers_are_canonical_only() {
+        for ok in ["0", "7", "10", "4294967295", "18446744073709551615"] {
+            assert!(strict_dec(ok).is_some(), "{ok}");
+        }
+        for bad in [
+            "",
+            "00",
+            "01",
+            "+1",
+            "-1",
+            " 1",
+            "1 ",
+            "1_0",
+            "1.0",
+            "18446744073709551616",
+            "٣",
+        ] {
+            assert!(strict_dec(bad).is_none(), "{bad:?}");
+        }
+        assert!(strict_hex("00ff", Some(2)).is_some());
+        for bad in ["00FF", "0g", "+f", "00f", "", "00ff00"] {
+            assert!(strict_hex(bad, Some(2)).is_none(), "{bad:?}");
+        }
+        assert!(strict_hex("", None).is_none());
+    }
+}
