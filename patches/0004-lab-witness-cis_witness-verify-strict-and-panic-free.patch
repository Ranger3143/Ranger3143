+    /// Every way the SAFE-01 H1 sweep found the old reader too forgiving.
+    #[test]
+    fn strict_rejects_every_leniency_the_h1_sweep_found() {
+        let base = lines(m7());
+        let mut cases: Vec<(String, String)> = Vec::new();
+        let mut add = |name: &str, text: String| cases.push((name.to_string(), text));
+
+        // C08: line reorder (every adjacent swap, and a rotation).
+        for i in 0..base.len() - 1 {
+            let mut l = base.clone();
+            l.swap(i, i + 1);
+            add(&format!("swap {i}/{}", i + 1), join(&l));
+        }
+        let mut l = base.clone();
+        l.rotate_left(3);
+        add("rotate", join(&l));
+        // U1/U2: prompt-toks / gen-toks changed or deleted.
+        for key in ["prompt-toks", "gen-toks"] {
+            let idx = base.iter().position(|x| x.starts_with(key)).unwrap();
+            let mut l = base.clone();
+            l.remove(idx);
+            add(&format!("delete {key}"), join(&l));
+            // prompt-toks is compared with the tokenizer's count at replay time
+            // (needs the artifacts), so a canonical-but-wrong prompt-toks is
+            // out of reach of the parser; gen-toks is checked against the ids.
+            let values: &[&str] = if key == "gen-toks" {
+                &["3", "5", "63", "65", "363", "064", "+64", "64 "]
+            } else {
+                &["04", "+4", "4 "]
+            };
+            for v in values {
+                let mut l = base.clone();
+                l[idx] = format!("{key} {v}");
+                add(&format!("{key} -> {v:?}"), join(&l));
+            }
+        }
+        assert_eq!(
+            strict(&m7().replace("prompt-toks 4", "prompt-toks 3"))
+                .unwrap()
+                .prompt_toks,
+            3,
+            "a canonical wrong prompt-toks passes the parser and is caught at replay"
+        );
+        // U3: header edited or deleted.
+        let mut l = base.clone();
+        l.remove(0);
+        add("delete header", join(&l));
+        for bad in [
+            "AEGIS-WITNESS v1-CIS ",
+            "AEGIS-WITNESS v1-CIs",
+            "#EGIS-WITNESS v1-CIS",
+            "AEGIS-WITNESS v2-CIS",
+            "",
+        ] {
+            let mut l = base.clone();
+            l[0] = bad.to_string();
+            add(&format!("header {bad:?}"), join(&l));
+        }
+        // U4: unknown lines (appended, inserted, blank).
+        let mut l = base.clone();
+        l.push("x-note hello".into());
+        add("unknown line appended", join(&l));
+        let mut l = base.clone();
+        l.insert(3, "x-note hello".into());
+        add("unknown line inserted", join(&l));
+        let mut l = base.clone();
+        l.insert(5, String::new());
+        add("blank line inserted", join(&l));
+        // U5: duplicate keys, bogus line first or last.
+        for (i, line) in base.iter().enumerate().skip(1) {
+            let mut l = base.clone();
+            l.insert(i, line.replace(|c: char| c.is_ascii_digit(), "1"));
+            add(&format!("duplicate (bogus first) line {i}"), join(&l));
+            let mut l = base.clone();
+            l.push(line.clone());
