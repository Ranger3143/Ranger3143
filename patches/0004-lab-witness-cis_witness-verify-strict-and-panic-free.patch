+        add(
+            "upper prompt-hex",
+            swap_in("prompt-hex", &|v| v.to_uppercase()),
+        );
+        add("upper chain", swap_in("chain", &|v| v.to_uppercase()));
+        add("upper model", swap_in("model", &|v| v.to_uppercase()));
+        add(
+            "upper cis-digest",
+            swap_in("cis-digest", &|v| v.to_uppercase()),
+        );
+        add("+maxtok", swap_in("maxtok", &|v| format!("+{v}")));
+        add("0maxtok", swap_in("maxtok", &|v| format!("0{v}")));
+        add("+token id", swap_in("token-ids", &|v| format!("+{v}")));
+        add("0token id", swap_in("token-ids", &|v| format!("0{v}")));
+        add(
+            "+a in prompt-hex",
+            swap_in("prompt-hex", &|v| format!("{}+a{}", &v[..2], &v[4..])),
+        );
+        add("trailing comma", swap_in("token-ids", &|v| format!("{v},")));
+        add(
+            "empty id",
+            swap_in("token-ids", &|v| v.replacen(',', ",,", 1)),
