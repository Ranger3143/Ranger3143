+/// The canonical receipt text, exactly as `cis_witness gen` prints it (and as
+/// the UEFI mint path renders it): LF line endings, `KEY_ORDER`, one trailing
+/// newline. `token-ids ` ends in a space when nothing was generated.
+fn render_receipt(
+    shas: (&[u8; 32], &[u8; 32], &[u8; 32]),
+    max_new: usize,
+    prompt: &str,
+    r: &Replay,
+) -> String {
+    let ids: Vec<String> = r.generated.iter().map(|t| t.to_string()).collect();
+    let mut s = String::new();
+    s.push_str(MAGIC);
+    s.push('\n');
+    s.push_str(&format!("model {}\n", hex(shas.0)));
+    s.push_str(&format!("embed {}\n", hex(shas.1)));
+    s.push_str(&format!("vocab {}\n", hex(shas.2)));
+    s.push_str(&format!("maxtok {max_new}\n"));
+    s.push_str(&format!("prompt-hex {}\n", hex(prompt.as_bytes())));
+    s.push_str(&format!("prompt-toks {}\n", r.prompt_toks));
+    s.push_str(&format!("gen-toks {}\n", r.generated.len()));
+    s.push_str(&format!("token-ids {}\n", ids.join(",")));
+    s.push_str(&format!("cis-digest {:016x}\n", r.fnv_digest));
+    s.push_str(&format!("chain {}\n", hex(&r.chain)));
+    s
+}
