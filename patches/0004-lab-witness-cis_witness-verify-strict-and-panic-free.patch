+                Some(v) => format!("prompt-hex {}", v.to_uppercase()),
+                None => x.clone(),
+            })
+            .collect::<Vec<_>>();
+        assert_eq!(parse_lenient(&join(&up)).unwrap(), want);
+        // Last duplicate wins.
+        let dup = format!("chain 00\n{}", m7());
+        assert_eq!(parse_lenient(&dup).unwrap(), want);
+    }
