+/// The original reader: split each line on the first space, dispatch on the
+/// key, ignore what it does not know, last duplicate wins. Same acceptance as
+/// before; failures that used to panic are `Err`.
+fn parse_lenient(text: &str) -> Result<Receipt, String> {
+    let mut r = Receipt::default();
+    for line in text.lines() {
+        let mut it = line.splitn(2, ' ');
+        let (k, v) = (it.next().unwrap_or(""), it.next().unwrap_or(""));
+        match k {
+            "model" => r.model = v.into(),
+            "embed" => r.embed = v.into(),
+            "vocab" => r.vocab = v.into(),
+            "maxtok" => {
+                r.maxtok = v
+                    .parse()
+                    .map_err(|_| "maxtok is not an unsigned integer".to_string())?;
+            }
+            "prompt-hex" => {
+                r.prompt = String::from_utf8(unhex_lenient(v)?)
+                    .map_err(|_| "prompt-hex does not decode to UTF-8 text".to_string())?;
+            }
+            "token-ids" => {
+                r.ids = v
+                    .split(',')
+                    .filter(|s| !s.is_empty())
+                    .map(|s| {
