+/// Canonical unsigned decimal: ASCII digits only, no sign, no leading zero
+/// (except the single digit `0`), and it must fit a `u64`.
+fn strict_dec(s: &str) -> Option<u64> {
+    let b = s.as_bytes();
+    if b.is_empty() || !b.iter().all(u8::is_ascii_digit) || (b.len() > 1 && b[0] == b'0') {
+        return None;
+    }
+    s.parse().ok()
+}
+
+/// Lower-case hex only (`0-9a-f`), even length. `want_bytes` pins the decoded
+/// length when given.
+fn strict_hex(s: &str, want_bytes: Option<usize>) -> Option<Vec<u8>> {
+    let b = s.as_bytes();
+    if b.is_empty() || !b.len().is_multiple_of(2) || want_bytes.is_some_and(|n| b.len() != 2 * n) {
+        return None;
+    }
+    let nib = |c: u8| match c {
+        b'0'..=b'9' => Some(c - b'0'),
+        b'a'..=b'f' => Some(c - b'a' + 10),
+        _ => None,
+    };
+    b.chunks_exact(2)
+        .map(|p| Some(nib(p[0])? << 4 | nib(p[1])?))
         .collect()
 }
 
+/// The `--strict` reader: accepts exactly the byte sequences the writers emit,
+/// and nothing else. Never panics; every failure names the offending line.
+fn parse_strict(bytes: &[u8]) -> Result<Receipt, String> {
+    // Byte alphabet: printable ASCII and LF. No CR, tab, NUL, other control or
+    // non-ASCII byte can appear anywhere (so no CRLF and no hidden blanks).
+    for (off, &b) in bytes.iter().enumerate() {
+        if b == b'\r' {
+            return Err(format!(
+                "byte {off}: carriage return (CRLF line endings are not canonical)"
+            ));
+        }
+        if b != b'\n' && !(0x20..=0x7e).contains(&b) {
+            return Err(format!(
+                "byte {off}: 0x{b:02x} is not printable ASCII or LF"
+            ));
+        }
+    }
+    if bytes.is_empty() {
+        return Err("empty file".into());
+    }
+    if bytes.last() != Some(&b'\n') {
+        return Err("no newline after the last line (exactly one is required)".into());
+    }
+    if bytes.ends_with(b"\n\n") {
+        return Err("blank line at the end (exactly one trailing newline is required)".into());
+    }
+    // ASCII-only was established above, so this cannot fail.
+    let text = std::str::from_utf8(&bytes[..bytes.len() - 1]).map_err(|e| e.to_string())?;
+    let lines: Vec<&str> = text.split('\n').collect();
+
+    if lines[0] != MAGIC {
+        return Err(format!("line 1: header must be exactly {MAGIC:?}"));
+    }
+    let mut r = Receipt::default();
+    for (i, &want) in KEY_ORDER.iter().enumerate() {
+        let n = i + 2; // 1-based line number; the header is line 1
+        let line = lines
+            .get(i + 1)
+            .ok_or_else(|| format!("truncated: line {n} ({want}) is missing"))?;
+        let (key, val) = line
+            .split_once(' ')
+            .ok_or_else(|| format!("line {n}: expected \"{want} <value>\""))?;
+        if key != want {
+            let why = if KEY_ORDER[..i].contains(&key) {
+                "duplicate key"
+            } else if KEY_ORDER.contains(&key) {
+                "key out of order"
+            } else {
+                "unknown key"
+            };
+            return Err(format!(
+                "line {n}: {why} {key:?}, canonical order expects {want:?}"
+            ));
+        }
+        let bad = |what: &str| format!("line {n} ({want}): {what}");
+        match want {
+            "model" | "embed" | "vocab" | "chain" => {
+                strict_hex(val, Some(32))
+                    .ok_or_else(|| bad("expected 64 lower-case hex digits"))?;
+                match want {
+                    "model" => r.model = val.into(),
+                    "embed" => r.embed = val.into(),
+                    "vocab" => r.vocab = val.into(),
+                    _ => r.chain = val.into(),
+                }
+            }
+            "cis-digest" => {
+                strict_hex(val, Some(8)).ok_or_else(|| bad("expected 16 lower-case hex digits"))?;
+                r.cis_digest = val.into();
+            }
+            "maxtok" | "prompt-toks" | "gen-toks" => {
+                let v = strict_dec(val)
+                    .and_then(|v| usize::try_from(v).ok())
+                    .ok_or_else(|| {
+                        bad("expected a decimal integer without sign or leading zeros")
+                    })?;
+                match want {
+                    "maxtok" => r.maxtok = v,
+                    "prompt-toks" => r.prompt_toks = v,
+                    _ => r.gen_toks = v,
+                }
+            }
+            "prompt-hex" => {
+                let raw = strict_hex(val, None)
+                    .ok_or_else(|| bad("expected non-empty lower-case hex of even length"))?;
+                r.prompt =
+                    String::from_utf8(raw).map_err(|_| bad("does not decode to UTF-8 text"))?;
+            }
+            "token-ids" => {
+                // `token-ids ` with an empty value is what the writers print for
+                // a receipt with zero generated tokens (the one place a line
+                // ends in a space); gen-toks must then be 0, checked below.
+                if !val.is_empty() {
+                    for part in val.split(',') {
+                        let id = strict_dec(part)
+                            .and_then(|v| u32::try_from(v).ok())
+                            .ok_or_else(|| {
+                                bad("expected comma-separated canonical decimal u32 ids")
+                            })?;
+                        r.ids.push(id);
+                    }
+                }
+            }
+            _ => unreachable!("KEY_ORDER is exhaustive"),
+        }
+    }
+    if let Some(extra) = lines.get(KEY_ORDER.len() + 1) {
+        let k = extra.split(' ').next().unwrap_or("");
+        return Err(format!(
+            "line {}: unexpected extra line {k:?} (a receipt has exactly {} lines)",
+            KEY_ORDER.len() + 2,
+            KEY_ORDER.len() + 1
+        ));
+    }
+    if r.gen_toks != r.ids.len() {
+        return Err(format!(
+            "gen-toks {} does not equal the token-ids count {}",
+            r.gen_toks,
+            r.ids.len()
+        ));
+    }
+    Ok(r)
+}
