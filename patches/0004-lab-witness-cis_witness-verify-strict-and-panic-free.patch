+/// The original lenient hex decoder, semantics unchanged: an odd trailing
+/// character is dropped, a pair that is not hex (including a stray non-hex
+/// character) decodes to 0, and `+a` decodes to 0x0a. The original sliced the
+/// string by byte offsets and panicked when a pair split a multi-byte
+/// character; that case is now an error. Kept so the default `verify` verdicts
+/// do not move; `--strict` uses `strict_hex` instead.
+fn unhex_lenient(s: &str) -> Result<Vec<u8>, String> {
+    let mut out = Vec::with_capacity(s.len() / 2);
+    for i in 0..s.len() / 2 {
+        let pair = s
+            .get(2 * i..2 * i + 2)
+            .ok_or_else(|| format!("prompt-hex: byte pair {i} splits a multi-byte character"))?;
+        out.push(u8::from_str_radix(pair, 16).unwrap_or(0));
+    }
+    Ok(out)
+}
+
+/// At most the first 16 bytes of `s`, cut on a character boundary (the
+/// original `&s[..16.min(len)]` panicked inside a multi-byte character; for
+/// ASCII, which every genuine value is, the result is identical).
+fn prefix16(s: &str) -> &str {
+    let mut n = 16.min(s.len());
+    while !s.is_char_boundary(n) {
+        n -= 1;
+    }
+    &s[..n]
+}
