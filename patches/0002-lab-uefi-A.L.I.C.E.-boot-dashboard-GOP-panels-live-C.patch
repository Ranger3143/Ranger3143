new file mode 100644
index 0000000..36543de
--- /dev/null
+++ b/aegis-uefi/src/ui.rs
@@ -0,0 +1,319 @@
+//! The A.L.I.C.E. boot dashboard — what a person standing at the machine sees.
+//!
+//! A no_std, allocation-light layer over the GOP console: a header with the
+//! mark and the mode badge, three state panels (MACHINE, PAYLOAD,
+//! ATTESTATION), a scrolling transcript viewport that every existing print
+//! site writes into unchanged, and a footer stage bar. Every value shown is
+//! read from the running system (CPUID, file sizes, SHA-256s, TPM PCRs); the
+//! dashboard renders state, it never invents it (prime directive 1).
+//!
+//! GOP-only. On the firmware text console every function here is a no-op and
+//! the plain transcript remains exactly as before.
+
+use crate::console;
+use alloc::format;
+use alloc::string::String;
+use alloc::vec::Vec;
+use crate::font;
+
+// Palette: deep navy field, cyan accent, amber for attention, green/red verdicts.
+pub const BG: u32 = 0x000A_0E1A;
+pub const PANEL: u32 = 0x0011_1A2E;
+pub const EDGE: u32 = 0x0024_314F;
+pub const ACCENT: u32 = 0x0038_E1FF;
+pub const ACCENT_DIM: u32 = 0x0018_6F80;
+pub const AMBER: u32 = 0x00FF_B020;
+pub const GREEN: u32 = 0x004A_DE80;
+pub const RED: u32 = 0x00FF_5C5C;
+pub const TEXT: u32 = 0x00E6_EAF2;
+pub const MUTED: u32 = 0x008A_97B5;
+pub const INK: u32 = 0x0005_0810;
+
+/// Stages shown in the footer bar, in order.
+pub const STAGES: [&str; 8] = ["BOOT", "VOLUME", "ALLOC", "LOAD", "HEAP", "ATTEST", "INFER", "DONE"];
+
+struct Layout {
+    cols: usize,
+    rows: usize,
+    cell_w: usize,
+    cell_h: usize,
+    width_px: usize,
+    header_rows: usize,
+    footer_rows: usize,
+    left_cols: usize,
+    machine_rows: usize,
+    payload_rows: usize,
+    attest_rows: usize,
+}
+
+static mut MODE_LABEL: [u8; 40] = [0; 40];
+static mut MODE_LEN: usize = 0;
+
+fn layout(c: &crate::gop::GopConsole) -> Layout {
+    let (cols, rows) = c.cells();
+    let (width_px, _h) = c.dims();
+    let cell_w = font::FONT_W * c.scale();
+    let cell_h = font::FONT_H * c.scale();
+    // Header and footer are sized in pixels (the mark is drawn at a fixed
+    // 3x glyph scale) and rounded up to whole text rows.
+    let header_rows = (160 + cell_h - 1) / cell_h;
+    let footer_rows = (96 + cell_h - 1) / cell_h;
+    // Side column: enough for "PCR12  " + a 32-hex digest prefix, at most 40% of the width.
+    let left_cols = (cols * 2 / 5).clamp(30, 50).min(cols.saturating_sub(40).max(30));
+    let body = rows.saturating_sub(header_rows + footer_rows);
+    let machine_rows = 7.min(body / 3);
+    let payload_rows = 7.min(body / 3);
+    let attest_rows = body.saturating_sub(machine_rows + payload_rows);
+    Layout { cols, rows, cell_w, cell_h, width_px, header_rows, footer_rows, left_cols, machine_rows, payload_rows, attest_rows }
+}
+
+fn panel(c: &mut crate::gop::GopConsole, l: &Layout, col: usize, row: usize, cols: usize, rows: usize, title: &str) {
+    let x = col * l.cell_w;
+    let y = row * l.cell_h;
+    let w = cols * l.cell_w;
+    let h = rows * l.cell_h;
+    c.fill_rect(x, y, w, h, PANEL);
+    // 2-px edge + accent title underline
+    c.fill_rect(x, y, w, 2, EDGE);
+    c.fill_rect(x, y + h - 2, w, 2, EDGE);
+    c.fill_rect(x, y, 2, h, EDGE);
+    c.fill_rect(x + w - 2, y, 2, h, EDGE);
+    c.text_cell(col + 1, row, title, ACCENT, Some(PANEL));
+    c.fill_rect(x + l.cell_w, y + l.cell_h - 3, (title.chars().count() * l.cell_w).min(w - 2 * l.cell_w), 2, ACCENT_DIM);
+}
+
+fn lines_in_panel(c: &mut crate::gop::GopConsole, _l: &Layout, col: usize, row: usize, cols: usize, rows: usize, lines: &[(String, u32)]) {
+    let inner_cols = cols.saturating_sub(2);
+    for (i, (text, color)) in lines.iter().enumerate().take(rows.saturating_sub(1)) {
+        let mut t: String = text.chars().take(inner_cols).collect();
+        while t.chars().count() < inner_cols {
+            t.push(' ');
+        }
+        c.text_cell(col + 1, row + 1 + i, &t, *color, Some(PANEL));
+    }
+}
+
+/// Draw the whole frame and hand the transcript viewport to the console.
+/// Returns false on the text-console fallback.
+pub fn init(mode: &str) -> bool {
+    set_mode_label(mode);
+    console::with_gop(|c| {
+        c.set_colors(TEXT, BG);
+        let l = layout(c);
+        // Field
+        c.fill_rect(0, 0, l.width_px, l.rows * l.cell_h, BG);
+        draw_header(c, &l);
+        panel(c, &l, 0, l.header_rows, l.left_cols, l.machine_rows, "MACHINE");
+        panel(c, &l, 0, l.header_rows + l.machine_rows, l.left_cols, l.payload_rows, "PAYLOAD");
+        panel(c, &l, 0, l.header_rows + l.machine_rows + l.payload_rows, l.left_cols, l.attest_rows, "ATTESTATION");
+        let tcols = l.cols - l.left_cols;
+        let trows = l.rows - l.header_rows - l.footer_rows;
+        panel(c, &l, l.left_cols, l.header_rows, tcols, trows, "TRANSCRIPT");
+        // Transcript viewport = inside the panel, below its title.
+        c.set_colors(TEXT, PANEL);
+        c.set_viewport(l.left_cols + 1, l.header_rows + 1, tcols.saturating_sub(2), trows.saturating_sub(2));
+        draw_footer(c, &l, 0, "");
+    })
+}
+
+fn set_mode_label(mode: &str) {
+    // SAFETY: single-threaded boot-time UI state; written before any AP runs
+    // UI code (APs never touch the dashboard).
+    unsafe {
+        let b = mode.as_bytes();
+        let n = b.len().min(40);
+        MODE_LABEL[..n].copy_from_slice(&b[..n]);
+        MODE_LEN = n;
+    }
+}
+
+fn mode_label() -> String {
+    // SAFETY: see set_mode_label.
+    unsafe { String::from_utf8_lossy(&MODE_LABEL[..MODE_LEN]).into_owned() }
+}
+
+fn draw_header(c: &mut crate::gop::GopConsole, l: &Layout) {
+    let h = l.header_rows * l.cell_h;
+    c.fill_rect(0, 0, l.width_px, h, INK);
+    c.fill_rect(0, h - 3, l.width_px, 3, ACCENT);
+    // Emblem: a cyan diamond with a dark core, left margin.
+    let r = (h / 2).saturating_sub(10);
+    let cx = r + 18;
+    let cy = h / 2 - 1;
+    for dy in 0..=r {
+        let w = r - dy;
+        c.fill_rect(cx - w, cy - dy, 2 * w + 1, 1, ACCENT);
+        c.fill_rect(cx - w, cy + dy, 2 * w + 1, 1, ACCENT);
+    }
+    let r2 = r / 2;
+    for dy in 0..=r2 {
+        let w = r2 - dy;
+        c.fill_rect(cx - w, cy - dy, 2 * w + 1, 1, INK);
+        c.fill_rect(cx - w, cy + dy, 2 * w + 1, 1, INK);
+    }
+    // Mark + tagline
+    let big = if h >= 150 { 3 } else { 2 };
+    let x0 = cx + r + 24;
+    c.text_px(x0, 8, "A.L.I.C.E.", TEXT, None, big);
+    let mark_end = x0 + 10 * font::FONT_W * big;
+    let tag_y = 8 + font::FONT_H * big + 4;
+    if tag_y + font::FONT_H < h {
+        c.text_px(x0, tag_y, "Aegis Lightweight Inference Core Engine  -  no operating system  -  bit-exact  -  TPM-attested", MUTED, None, 1);
+    }
+    // Mode badge, right-aligned, 2x glyphs when the panel has room for it.
+    let m = mode_label();
+    let mut bs = if l.width_px >= 1600 { 2 } else { 1 };
+    let mut badge_w = (m.chars().count() + 2) * font::FONT_W * bs;
+    if l.width_px.saturating_sub(badge_w + 16) < mark_end + 16 {
+        bs = 1;
+        badge_w = (m.chars().count() + 2) * font::FONT_W;
+    }
+    let bx = l.width_px.saturating_sub(badge_w + 16);
+    let by = 10;
+    c.fill_rect(bx, by, badge_w, font::FONT_H * bs + 8, ACCENT);
+    c.text_px(bx + font::FONT_W * bs, by + 4, &m, INK, None, bs);
+}
+
+fn draw_footer(c: &mut crate::gop::GopConsole, l: &Layout, stage_idx: usize, status: &str) {
+    let y = (l.rows - l.footer_rows) * l.cell_h;
+    let h = l.footer_rows * l.cell_h;
+    c.fill_rect(0, y, l.width_px, h, INK);
+    c.fill_rect(0, y, l.width_px, 2, EDGE);
+    // Segmented stage bar across the top half of the footer.
+    let n = STAGES.len();
+    let gap = 6;
+    let seg_w = (l.width_px - 32 - gap * (n - 1)) / n;
+    let seg_h = (l.cell_h / 2).max(8);
+    for (i, name) in STAGES.iter().enumerate() {
+        let x = 16 + i * (seg_w + gap);
+        let color = if i < stage_idx { ACCENT } else if i == stage_idx { AMBER } else { EDGE };
+        c.fill_rect(x, y + 8, seg_w, seg_h, color);
+        let label_color = if i <= stage_idx { TEXT } else { MUTED };
+        c.text_px(x, y + 8 + seg_h + 4, name, label_color, None, 1);
+    }
+    // Status text, right half of the second row
+    if !status.is_empty() {
+        let max_chars = (l.width_px / 2) / font::FONT_W;
+        let t: String = status.chars().take(max_chars).collect();
+        let tx = l.width_px.saturating_sub(16 + t.chars().count() * font::FONT_W);
+        c.text_px(tx, y + h - font::FONT_H - 4, &t, ACCENT, Some(INK), 1);
+    }
+}
+
+/// Advance the footer stage bar. `idx` indexes `STAGES`.
+pub fn stage(idx: usize, status: &str) {
+    console::with_gop(|c| {
+        let l = layout(c);
+        draw_footer(c, &l, idx.min(STAGES.len()), status);
+    });
+}
+
+pub fn set_mode(mode: &str) {
+    set_mode_label(mode);
+    console::with_gop(|c| {
+        let l = layout(c);
+        draw_header(c, &l);
+    });
+}
+
+fn fill_panel(which: usize, lines: &[(String, u32)]) {
+    console::with_gop(|c| {
+        let l = layout(c);
+        let (row, rows, title) = match which {
+            0 => (l.header_rows, l.machine_rows, "MACHINE"),
+            1 => (l.header_rows + l.machine_rows, l.payload_rows, "PAYLOAD"),
+            _ => (l.header_rows + l.machine_rows + l.payload_rows, l.attest_rows, "ATTESTATION"),
+        };
+        panel(c, &l, 0, row, l.left_cols, rows, title);
+        lines_in_panel(c, &l, 0, row, l.left_cols, rows, lines);
+    });
+}
+
+pub fn machine(lines: &[(String, u32)]) {
+    fill_panel(0, lines);
+}
+pub fn payload(lines: &[(String, u32)]) {
+    fill_panel(1, lines);
+}
+pub fn attest(lines: &[(String, u32)]) {
+    fill_panel(2, lines);
+}
+
+/// Convenience: "KEY  value" line with the key in the muted colour.
+pub fn kv(key: &str, value: &str, color: u32) -> (String, u32) {
+    let _ = color;
+    (format!("{key:<7}{value}"), TEXT)
+}
+
+/// Short digest prefix for panel lines.
+pub fn short_hex(hex: &str, n: usize) -> String {
+    let s: String = hex.chars().take(n).collect();
+    format!("{s}..")
+}
+
+/// Human-readable byte count.
+pub fn human_bytes(b: usize) -> String {
+    if b >= 1 << 30 {
+        format!("{}.{:02} GB", b >> 30, ((b & ((1 << 30) - 1)) * 100) >> 30)
+    } else if b >= 1 << 20 {
+        format!("{}.{:01} MB", b >> 20, ((b & ((1 << 20) - 1)) * 10) >> 20)
+    } else if b >= 1 << 10 {
+        format!("{} KB", b >> 10)
+    } else {
+        format!("{b} B")
+    }
+}
+
+/// Build the attestation panel lines from the attestor's state and the
+/// report text (pcr/quote lines), so main.rs only forwards what it has.
+pub fn attest_lines_from_report(measured: &[(u32, String)], report: &str, tpm_present: bool) -> Vec<(String, u32)> {
+    let mut v: Vec<(String, u32)> = Vec::new();
+    if !tpm_present {
+        v.push((String::from("TPM    none (EFI_TCG2 absent)"), AMBER));
+        v.push((String::from("       receipts unattested this boot"), MUTED));
+        return v;
+    }
+    v.push((String::from("TPM    EFI_TCG2 present, SHA-256 bank"), GREEN));
+    let n12 = measured.iter().filter(|(p, _)| *p == 12).count();
+    let n13 = measured.iter().filter(|(p, _)| *p == 13).count();
+    v.push((format!("PCR12  {n12} payload measurement event(s)"), TEXT));
+    v.push((format!("PCR13  {n13} receipt event(s)"), TEXT));
+    for line in report.lines() {
+        if let Some(rest) = line.strip_prefix("pcr ") {
+            let mut it = rest.splitn(2, ' ');
+            let (p, hex) = (it.next().unwrap_or(""), it.next().unwrap_or(""));
+            v.push((format!("PCR{p:<4}{}", short_hex(hex, 32)), TEXT));
+        }
+    }
+    let mut quote_ok = false;
+    for line in report.lines() {
+        if line.starts_with("quote-sig-s ") {
+            quote_ok = true;
+        }
+        if let Some(e) = line.strip_prefix("quote-error ") {
+            v.push((format!("QUOTE  error: {}", e.chars().take(30).collect::<String>()), RED));
+        }
+        if let Some(r) = line.strip_prefix("quote-retries ") {
+            v.push((format!("QUOTE  TPM2_Quote PCR 4+12+13 signed, retry {r}"), GREEN));
+        }
+    }
+    if quote_ok {
+        v.push((String::from("KEY    ECC P-256 ECDSA/SHA-256 (owner)"), MUTED));
+    }
+    v
+}
+
+/// Receipt summary lines for the attestation panel (mint or verify).
+pub fn receipt_lines(mode: &str, chain: &[u8; 32], cis_digest: u64, steps: usize, verdict: &str, color: u32) -> Vec<(String, u32)> {
+    let mut buf = [0u8; 64];
+    let n = aegis_core::witness::hex_lower(chain, &mut buf);
+    let hex = core::str::from_utf8(&buf[..n]).unwrap_or("");
+    alloc::vec![
+        (String::new(), TEXT),
+        (format!("RECEIPT witness v1-CIS ({mode})"), ACCENT),
+        (format!("STEPS  {steps} tokens, CIS-1 FullInt, argmax"), TEXT),
+        (format!("DIGEST {cis_digest:016x}  FNV-1a (ids)"), TEXT),
+        (format!("CHAIN  {}", short_hex(hex, 32)), TEXT),
+        (format!("VERDICT {verdict}"), color),
+    ]
+}
