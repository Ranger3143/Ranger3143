+/// Run `f` against the GOP console if it is the active backend. Returns
+/// false (and does nothing) on the text-console fallback — the dashboard is
+/// GOP-only and degrades to the plain transcript there.
+#[allow(dead_code)]
+pub fn with_gop<F>(f: F) -> bool
+where
+    F: FnOnce(&mut GopConsole),
+{
+    #[cfg(feature = "gop")]
+    {
+        let mut guard = GOP_CONSOLE.lock();
+        if let Some(gop) = guard.as_mut() {
+            f(gop);
+            return true;
+        }
+    }
+    #[cfg(not(feature = "gop"))]
+    {
+        let _ = f;
+    }
+    false
+}
+
 /// Call `f` with whichever console backend is active. Mirrors the shape of
 /// `uefi::system::with_stdout` so call sites are unchanged apart from the
 /// function path.
