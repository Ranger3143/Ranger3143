@@ -0,0 +1,205 @@
+//! Minimal receipt-gated tool gateway for the mint path (no OS underneath).
+//!
+//! Mirrors `aegis-linux/examples/agent_trace.rs`: the scanner looks at the
+//! model's newly decoded text only, takes the EARLIEST-starting `CALC(` or
+//! `LOOKUP(` opener, parses only that one with its own grammar, and never
+//! falls back to another occurrence. `CALC(<i64> <op> <i64>)` uses checked
+//! i64 arithmetic with the gateway's fixed error strings (`div-by-zero`,
+//! `overflow`); `LOOKUP(<key>)` with key `[A-Za-z0-9_.-]{1,64}` resolves
+//! against a declared table (`TABLE.TSV`, `key<TAB>value` rows) and returns
+//! the literal `NONE` on a miss. `LOOKUP(` is not scanned for at all when no
+//! table is declared, exactly as the Linux gateway behaves without `--table`.
+//!
+//! The tool result is appended to the prompt as `\nTOOL[<name>]=<output>\n`
+//! and the model decodes a second step; both steps are ordinary witness
+//! receipts, so any host can replay them with `cis_witness verify`.
+
+use alloc::format;
+use alloc::string::String;
+use alloc::vec::Vec;
+
+pub struct ToolOutcome {
+    pub name: &'static str, // "calc" | "calc-error" | "lookup" | "no-tool"
+    pub input: String,      // the matched call text, or empty
+    pub output: String,     // decimal result / error string / table value / NONE
+}
+
+pub struct Table {
+    pub rows: Vec<(String, String)>,
+    pub bytes: usize,
+    pub sha256: [u8; 32],
+}
+
+pub fn eval_calc(a: i64, op: u8, b: i64) -> Result<i64, &'static str> {
+    match op {
+        b'+' => a.checked_add(b).ok_or("overflow"),
+        b'-' => a.checked_sub(b).ok_or("overflow"),
+        b'*' => a.checked_mul(b).ok_or("overflow"),
+        b'/' => {
+            if b == 0 {
+                Err("div-by-zero")
+            } else {
+                a.checked_div(b).ok_or("overflow")
+            }
+        }
+        b'%' => {
+            if b == 0 {
+                Err("div-by-zero")
+            } else {
+                a.checked_rem(b).ok_or("overflow")
+            }
+        }
+        _ => Err("bad-op"),
+    }
+}
+
+pub fn is_valid_key(key: &str) -> bool {
+    !key.is_empty()
+        && key.len() <= 64
+        && key
+            .bytes()
+            .all(|c| c.is_ascii_alphanumeric() || c == b'_' || c == b'.' || c == b'-')
+}
+
+/// Parse the `CALC(...)` call that starts at `start`. Returns
+/// (matched text, a, op, b) or None if the body does not fit the grammar.
+fn parse_calc(text: &str, start: usize) -> Option<(String, i64, u8, i64)> {
+    let rest = &text[start + "CALC(".len()..];
+    let close = rest.find(')')?;
+    let body = &rest[..close];
+    let mut it = body.split_whitespace();
+    let a: i64 = it.next()?.parse().ok()?;
+    let op = match it.next()? {
+        "+" => b'+',
+        "-" => b'-',
+        "*" => b'*',
+        "/" => b'/',
+        "%" => b'%',
+        _ => return None,
+    };
+    let b: i64 = it.next()?.parse().ok()?;
+    if it.next().is_some() {
+        return None;
+    }
+    let full = &text[start..start + "CALC(".len() + close + 1];
+    Some((String::from(full), a, op, b))
+}
+
+fn parse_lookup(text: &str, start: usize) -> Option<(String, String)> {
+    let rest = &text[start + "LOOKUP(".len()..];
+    let close = rest.find(')')?;
+    let key = &rest[..close];
+    if !is_valid_key(key) {
+        return None;
+    }
+    let full = &text[start..start + "LOOKUP(".len() + close + 1];
+    Some((String::from(full), String::from(key)))
+}
+
+pub fn parse_table(bytes: &[u8]) -> Option<Table> {
+    if bytes.is_empty() {
+        return None;
+    }
+    let s = core::str::from_utf8(bytes).ok()?;
+    let mut rows = Vec::new();
+    for line in s.lines() {
+        let line = line.trim_end_matches('\r');
+        if line.is_empty() {
+            continue;
+        }
+        if let Some((k, v)) = line.split_once('\t')
+            && is_valid_key(k)
+        {
+            rows.push((String::from(k), String::from(v)));
+        }
+    }
+    Some(Table {
+        rows,
+        bytes: bytes.len(),
+        sha256: aegis_core::witness::sha256(bytes),
+    })
+}
+
+fn no_tool() -> ToolOutcome {
+    ToolOutcome {
+        name: "no-tool",
+        input: String::new(),
+        output: String::new(),
+    }
+}
+
+/// Scan `decoded` for the earliest `CALC(` / `LOOKUP(` opener and run it.
+pub fn run_tool(decoded: &str, table: Option<&Table>) -> ToolOutcome {
+    let calc_pos = decoded.find("CALC(");
+    let lookup_pos = if table.is_some() {
+        decoded.find("LOOKUP(")
+    } else {
+        None
+    };
+    let pick_lookup = match (calc_pos, lookup_pos) {
+        (Some(c), Some(l)) => l < c,
+        (None, Some(_)) => true,
+        _ => false,
+    };
+    if pick_lookup {
+        let start = lookup_pos.unwrap();
+        let Some((full, key)) = parse_lookup(decoded, start) else {
+            return no_tool();
+        };
+        let table = table.unwrap();
+        let value = table
+            .rows
+            .iter()
+            .find(|(k, _)| *k == key)
+            .map(|(_, v)| v.clone())
+            .unwrap_or_else(|| String::from("NONE"));
+        return ToolOutcome {
+            name: "lookup",
+            input: full,
+            output: value,
+        };
+    }
+    let Some(start) = calc_pos else {
+        return no_tool();
+    };
+    let Some((full, a, op, b)) = parse_calc(decoded, start) else {
+        return no_tool();
+    };
+    match eval_calc(a, op, b) {
+        Ok(v) => ToolOutcome {
+            name: "calc",
+            input: full,
+            output: format!("{v}"),
+        },
+        Err(msg) => ToolOutcome {
+            name: "calc-error",
+            input: full,
+            output: String::from(msg),
+        },
+    }
+}
+
+/// True once `text` holds a complete `CALC(...)`/`LOOKUP(...)` call followed by
+/// a newline (the model has finished its call line). Used to end step 0 early.
+pub fn call_line_complete(text: &str) -> bool {
+    for opener in ["CALC(", "LOOKUP("] {
+        if let Some(start) = text.find(opener)
+            && let Some(close) = text[start..].find(')')
+            && text[start + close..].contains('\n')
+        {
+            return true;
+        }
+    }
+    false
+}
+
+/// Exactly the text the Linux gateway appends to the running prompt.
+pub fn tool_result_text(o: &ToolOutcome) -> String {
+    format!("\nTOOL[{}]={}\n", o.name, o.output)
+}
+
+pub fn hex32(d: &[u8; 32]) -> String {
+    let mut buf = [0u8; 64];
+    let n = aegis_core::witness::hex_lower(d, &mut buf);
+    String::from(core::str::from_utf8(&buf[..n]).unwrap_or(""))
+}
